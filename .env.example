# Copy to .env; `make dev` and `make prod` read it from the repo root.

# PostgreSQL. Host and port default to the compose service (postgres:5432); `make` targets point them at localhost.
DB_NAME=club110
DB_USER=club110
# Required, no default
DB_PASSWORD=

# Redis (aiogram FSM storage). Host and port default to the compose service (redis:6379).
REDIS_PASSWORD=

# Telegram bot token from @BotFather
BOT_TOKEN=

# Admin panel auth. Owners: JSON list of Telegram user ids with every permission, e.g. [123456789]
AUTH_OWNER_IDS=[]
# Telegram Login Widget needs the site domain set for the bot via @BotFather /setdomain
AUTH_WIDGET_ENABLED=false
# false only for plain-http local runs; Safari drops Secure cookies on http://localhost
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_DAYS=30

# loguru level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Image used by docker compose. `make build` tags club110-backend:latest; on the server CI-pushed GHCR image
BACKEND_IMAGE=club110-backend
IMAGE_TAG=latest
