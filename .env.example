# Copy to .env; `make dev` and `make prod` read it from the repo root.

# PostgreSQL. Host and port default to the compose service (postgres:5432); `make` targets point them at localhost.
DB_NAME=club110
DB_USER=club110
# Required, no default
DB_PASSWORD=

# Redis (aiogram FSM storage). Host and port default to the compose service (redis:6379).
REDIS_PASSWORD=

# Telegram bot token from @BotFather
BOT_TOKEN=

# Admin panel auth. Owners: JSON list of Telegram user ids with every permission, e.g. [123456789]
AUTH_OWNER_IDS=[]
# Telegram Login Widget needs the site domain set for the bot via @BotFather /setdomain
AUTH_WIDGET_ENABLED=false
# false only for plain-http local runs; Safari drops Secure cookies on http://localhost
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_DAYS=30

# Public https address of the admin panel, no trailing slash, e.g. https://club.example.com (VK ID callback, /adminka link)
PUBLIC_URL=

# Telegram chat id for owner alerts (sync failures, removals to confirm), e.g. -1001234567890. Empty: alerts go only to the log
ALERTS_CHAT_ID=

# VK app from id.vk.com. VK ID mode needs the app id (client_id) and PUBLIC_URL;
# "profile link" mode needs the service token to resolve links via the VK API. Empty: the mode is unavailable
VK_CLIENT_ID=
VK_SERVICE_TOKEN=

# Google service account JSON key (read-only access to club sheets). Empty = sheet sync disabled.
# make dev: ../secrets/google-service-account.json (relative to backend/); docker: /run/secrets/google-service-account.json
GOOGLE_CREDENTIALS_FILE=
# How often the worker syncs club memberships from the sheets
SYNC_INTERVAL_MINUTES=10

# loguru level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Images used by docker compose. `make build` tags club110-backend:latest and club110-web:latest
BACKEND_IMAGE=club110-backend
WEB_IMAGE=club110-web
IMAGE_TAG=latest

# Admin panel port on 127.0.0.1; the host's reverse proxy (TLS, domain) forwards to it. `make prod`: http://localhost:8080
WEB_PORT=8080
